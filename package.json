{
  "name": "streamsense",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["frontend", "backend"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "npm run start:backend",
    "dev": "concurrently --kill-others -n web,api \"npm run dev -w frontend\" \"npm run dev -w backend\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:integration": "vitest run frontend/src/release.integration.test.tsx",
    "test:watch": "vitest",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "start:backend": "npm run start -w backend"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "concurrently": "10.0.6",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
