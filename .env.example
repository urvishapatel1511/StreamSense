# Copy to .env in the project root. Enter credentials there only, never in this example.
PORT=3001
TWITCH_CLIENT_ID=replace_with_your_twitch_application_client_id
TWITCH_CLIENT_SECRET=replace_with_your_twitch_application_client_secret
TWITCH_REDIRECT_URI=http://localhost:3001/auth/twitch/callback
FRONTEND_URL=http://localhost:5173
# Optional deterministic processing settings. Existing .env files use these defaults.
SUMMARY_INTERVAL_SECONDS=20
SUMMARY_MAX_QUEUE_SIZE=500
SUMMARY_MAX_HISTORY=20
SUMMARY_ACTIVITY_WINDOW_SECONDS=20
ACTIVITY_NORMAL_MIN=5
ACTIVITY_BUSY_MIN=15
ACTIVITY_VERY_BUSY_MIN=30
# Local sessions use random opaque cookie IDs backed by in-memory server data.
# No access token, refresh token, or session secret belongs in the frontend.
# Never prefix credentials with VITE_: Vite exposes those values to browsers.
